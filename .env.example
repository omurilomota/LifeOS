# LifeOS local environment example
# Copy to .env for local overrides; do not commit secrets.

# App
APP_ENV=local
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080

# Postgres
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/lifeos
DB_USERNAME=lifeos
DB_PASSWORD=lifeos
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
FILE_STORAGE_ROOT=./docker-data/storage

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional future integrations
# AI_PROVIDER=
# AI_API_KEY=
# SMTP_HOST=
